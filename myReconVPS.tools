# myReconVPS.tools - Arquivo de configuração de ferramentas
# Renato Andalik

# ULTIMA ATUALIZACAO: 24/09/2026

# INSTRUCOES
# Adicione comandos para instalacao de ferramentas no formato:
#  commands["toolname1"]="command1 && command2 && ..."
# A ordem de instalação será determinada pela ordem em que as ferramentas são definidas neste arquivo.
# Agrupe as ferramentas com marcadores '# CATEGORY: <nome>' (usados pelo menu).

# Tratamento de variaveis e caracteres especiais
#  Aspas duplas sao utilizadas para delimitar o comando completo, portanto,
#  na sua construcao de comando, utilize APENAS aspas simples.
#  Em variaveis, utilize o caractere de escape.
#  Por exemplo, $LATEST_VERSION fica \$LATEST_VERSION

# Para adicionar um diretorio ao PATH, use a funcao add_path (definida no .sh):
#  ... && add_path /opt/minhaferramenta
#  Ela persiste o PATH (de forma idempotente) no rc do root E do usuario do
#  sudo, e tambem na sessao atual. Encadeie sempre com '&&' para que uma falha
#  na etapa anterior seja detectada (nao use o antigo padrao 'grep || echo').

# Variaveis disponiveis para uso nos comandos:
#  CONFIG_FILE
#  | aponta para o arquivo de configuracao de sessao do shell do root
#  | (.profile, .bashrc ou .zshrc)

# Configurações gerais
min_space=5 # Espaço mínimo em disco (GB)

# CATEGORY: Mandatórios
commands["ubuntu-update"]="apt-get update && apt-get -y upgrade"
order+=("ubuntu-update")

commands["basic-tools"]="apt-get -y install snapd git curl wget unzip gzip ftp telnet tcpdump net-tools ca-certificates"
order+=("basic-tools")

commands["go"]="LATEST_VERSION=\$(curl -s 'https://go.dev/VERSION?m=text' | head -n 1) && wget https://go.dev/dl/\$LATEST_VERSION.linux-amd64.tar.gz && rm -rf /usr/local/go && tar -C /usr/local -xzf \$LATEST_VERSION.linux-amd64.tar.gz && rm -f \$LATEST_VERSION.linux-amd64.tar.gz && add_path /usr/local/go/bin"
order+=("go")

commands["python3"]="apt-get -y install python3-pip"
order+=("python3")

# CATEGORY: Programas de Reconhecimento
commands["airixss"]="go install github.com/ferreiraklet/airixss@latest && mkdir -p /opt/airixss ; mv -f ~/go/bin/airixss /opt/airixss/ && add_path /opt/airixss"
order+=("airixss")

commands["amass"]="CGO_ENABLED=0 go install -v github.com/owasp-amass/amass/v5/cmd/amass@main && mkdir -p /opt/amass ; mv -f ~/go/bin/amass /opt/amass/ && add_path /opt/amass"
order+=("amass")

commands["anew"]="go install github.com/tomnomnom/anew@latest && mkdir -p /opt/anew ; mv -f ~/go/bin/anew /opt/anew/ && add_path /opt/anew"
order+=("anew")

commands["archivefuzz"]="git clone https://github.com/devanshbatham/ArchiveFuzz && cd ArchiveFuzz && pip3 install -r requirements.txt && cd .. && cp -rf ArchiveFuzz/ /opt/archivefuzz && rm -rf ArchiveFuzz && add_path /opt/archivefuzz"
order+=("archivefuzz")

commands["arjun"]="pip3 install arjun"
order+=("arjun")

